{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "bunVersion": "1.x",
  "installCommand": "bun install",
  "buildCommand": "cd packages/db && bunx prisma generate && cd ../../apps/dashboard-frontend && bun run build",
  "outputDirectory": "apps/dashboard-frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
